{
  "name": "k-bigdata-contest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/data.test.mjs tests/build.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs tests/indexnow.test.mjs && node scripts/check-seo.mjs",
    "check:live": "node scripts/check-seo.mjs --live",
    "notify:indexnow": "node scripts/notify-indexnow.mjs",
    "sync:youtube": "node scripts/sync-youtube.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
